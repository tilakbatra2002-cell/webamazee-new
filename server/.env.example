# ---------------------------------------------------------------------------
# Webamazee Invoice Generator - API server
# Copy to server/.env and fill in real values. NEVER commit the .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5001

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/webamazee_invoices
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/webamazee_invoices?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Public URLs. CLIENT_URL is added to the CORS allow-list.
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5001

# Optional: extra comma-separated origins allowed by CORS.
EXTRA_CORS_ORIGINS=

# Credentials used by `npm run seed` when creating the demo admin account.
ADMIN_EMAIL=admin@webamazee.com
ADMIN_PASSWORD=

# Optional: path to a system Chromium/Chrome for PDF + image rendering.
# Leave blank to use the bundled @sparticuz/chromium build.
CHROMIUM_PATH=
