# ---------------------------------------------------------------------------
# Webamazee Invoice Generator - React client
# Copy to client/.env.local. NEVER commit the real file.
# ---------------------------------------------------------------------------

# Absolute URL of the deployed API, e.g. https://webamazee-invoices-api.onrender.com/api
# Leave unset in development: Vite proxies /api to VITE_API_PROXY instead.
VITE_API_URL=

# Dev-only: where `npm run dev` proxies /api requests (defaults to http://127.0.0.1:5001).
VITE_API_PROXY=http://127.0.0.1:5001
