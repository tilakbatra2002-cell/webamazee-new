# ==============================================================================
# Webamazee Website & Blog CMS Environment Variables
# ==============================================================================
# Copy this file to `.env.local` for local development and configure the same
# variables in Vercel Project Settings -> Environment Variables.
# NEVER commit `.env.local` or share live secret values in code or logs.

# ------------------------------------------------------------------------------
# MongoDB Atlas (Required for Blog CMS persistence & Admin Auth)
# ------------------------------------------------------------------------------
# Connection string from MongoDB Atlas (SRV format recommended).
MONGODB_URI=
# Database name to use inside the cluster (defaults to "webamazee").
MONGODB_DB=webamazee

# ------------------------------------------------------------------------------
# Vercel Blob (Required for Media Library image uploads & management)
# ------------------------------------------------------------------------------
# Read-write token generated by Vercel Blob storage. Kept strictly server-side.
BLOB_READ_WRITE_TOKEN=

# ------------------------------------------------------------------------------
# Admin Authentication & Scheduled Publishing Security
# ------------------------------------------------------------------------------
# Random high-entropy secret (>= 32 characters) used to sign HTTP-only admin
# session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=
# Random secret sent by Vercel Cron (`Authorization: Bearer <CRON_SECRET>`) to
# authorize /api/cron/publish-scheduled. Generate with: openssl rand -hex 32
CRON_SECRET=

# ------------------------------------------------------------------------------
# Site Canonical URL
# ------------------------------------------------------------------------------
# Public canonical base URL used for invite/reset links and origin checks.
NEXT_PUBLIC_SITE_URL=https://www.webamazee.com

# ------------------------------------------------------------------------------
# Email Delivery via Resend (Contact forms + Admin invite / password reset)
# ------------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_EMAIL=info@webamazee.com

# ------------------------------------------------------------------------------
# Optional Google PageSpeed Insights API (Free SEO Audit tool)
# ------------------------------------------------------------------------------
# If unset, the Performance category is shown as "Not enough data".
GOOGLE_PAGESPEED_API_KEY=
